# Copy to backend/local/backend.env (git-ignored) and adjust. Read by scripts/rb.ps1 and passed to every
# service container. Values here are examples; nothing secret belongs in this file in git.

# Host address the published ports bind to (0.0.0.0 = every interface, so kiosks on the LAN can connect).
BIND_ADDRESS=0.0.0.0

# Extra names/IPs for the server certificate (comma separated), e.g. your LAN IP or your own host names.
EXTRA_HOSTNAMES=
EXTRA_IPS=

# Base URL kiosks use for BITS downloads of Update Service change sets (must resolve on the kiosk).
UPDATE_CONTENT_BASE_URL=http://updatesvc.redbox.com:7080
# Base URL of presigned S3 URLs (served by rb-cloudapi on 443).
S3_BASE_URL=https://files.kiosk.prod.redbox.com

# Optional plain rcp:// listener for the Update Service (0 = off), e.g. 7012 for testing.
UPDATE_SERVICE_PLAIN_PORT=0
# Verify updatemgrd's h: credential hash (leave empty to accept every store).
UPDATE_SERVICE_KEY1=
UPDATE_SERVICE_KEY2=

# Card authorisation: approve | decline | rules
PAYMENT_MODE=approve

# MQTT: require the client certificate issued by our certificate service (CN = kiosk id).
MQTT_REQUIRE_CLIENT_CERT=true
MQTT_PLAIN_PORT=0

LOG_LEVEL=INFO

# Cloud APIs (see docs/cloud-apis.md): refuse requests without one of these API keys when enforcement is on.
CLOUD_API_ENFORCE_KEYS=false
CLOUD_API_KEYS=
# Base of planogram/asset/ad URLs handed to kiosks (empty = taken from the request's host).
CLOUD_PUBLIC_BASE_URL=

# Admin dashboard (rb-admin). Set the login with `scripts/rb.ps1 set-admin-password`, which adds
# ADMIN_USERNAME and ADMIN_PASSWORD_HASH (PBKDF2 hash only) to local/backend.env. Never put a password here.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8443
ADMIN_TLS=true
ADMIN_SESSION_HOURS=8
